# Public (safe to expose to the browser, must be prefixed with VITE_)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

# Server-only (SSR loaders/actions, never prefix with VITE_)
# Same project URL/anon key as above, just read via process.env server-side
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Direct Postgres connection string (Supabase project settings > Database),
# used only by src/lib/db.server.ts for wallet transactions. Bypasses RLS.
DATABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

